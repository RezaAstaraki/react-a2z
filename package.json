  "files": [
    "dist",
    "tailwind.preset.js",
    "tailwind.preset.d.ts",
    "tailwind.css",
    "tokens.css",
    "components.css",
    "styles.css",
    "styles"
  ],
  "scripts": {
    "registry:build": "node scripts/build-registry.mjs",
    "cli:test": "npm run registry:build && node scripts/test-cli.mjs && node scripts/test-cli-styles.mjs",
    "cli:check": "npm pack ./packages/react-a2z-cli --dry-run",
    "cli:apps:prepare": "npm --prefix tests/cli-apps run bootstrap",
    "cli:apps:check": "npm --prefix tests/cli-apps run check",
    "release:cli": "cd packages/react-a2z-cli && npm publish --access public",
    "release:baseline": "node scripts/release-baseline.mjs",
    "release:check": "node --test tests/release-policy.test.mjs && npm test && node scripts/check-release.mjs",
    "release:compare": "node scripts/check-release.mjs",
    "prepublishOnly": "npm run release:check && node scripts/check-release.mjs --publish",
    "rollup": "rollup -c --bundleConfigAsCjs",
    "dev": "rollup -c --bundleConfigAsCjs --watch",
    "build": "npm run typecheck && npm run rollup && node scripts/build-cjs-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node tests/components.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RezaAstaraki/react-a2z.git"
  },
  "keywords": [
